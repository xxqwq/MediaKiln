{
  "name": "video-gif-toolbox",
  "version": "0.1.0",
  "shellVersion": "0.1.0",
  "description": "MediaKiln — Windows 本地离线视频 · 动图 · 图片 · 音频 · 文档工具箱，提供 73 个本地工具",
  "main": "main.js",
  "bin": {
    "mediakiln": "./cli.js"
  },
  "author": "user",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "cli": "node cli.js",
    "ensure-ffmpeg": "node scripts/ensure-ffmpeg.js",
    "postinstall": "node scripts/ensure-ffmpeg.js",
    "prepack": "node scripts/ensure-ffmpeg.js",
    "predist": "node scripts/ensure-ffmpeg.js",
    "pack": "electron-builder --win portable --dir",
    "dist": "electron-builder --win portable nsis",
    "hotfix:build": "node scripts/build-hotfix.js",
    "hotfix:release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release.ps1 -HotfixOnly",
    "release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release.ps1"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "adm-zip": "^0.6.1",
    "highlight.js": "^11.12.0",
    "imagetracerjs": "^1.2.6",
    "pdf-lib": "^1.17.1",
    "svgo": "^4.1.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.local.video-gif-toolbox",
    "productName": "MediaKiln",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "cli.js",
      "ffmpeg.js",
      "preload.js",
      "core/**/*",
      "modules/**/*",
      "renderer/**/*"
    ],
    "asarUnpack": [
      "node_modules/@resvg/**/*"
    ],
    "extraFiles": [
      {
        "from": "build/cli/mediakiln.cmd",
        "to": "mediakiln.cmd"
      }
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin",
        "filter": [
          "ffmpeg.exe",
          "ffprobe.exe"
        ]
      }
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "MediaKiln-${version}-便携版.exe"
    },
    "nsis": {
      "oneClick": true,
      "include": "build/installer.nsh",
      "artifactName": "MediaKiln-${version}-安装版.exe"
    }
  }
}
