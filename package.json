{
  "name": "video-gif-toolbox",
  "version": "2.1.3",
  "description": "视频 · GIF · 图片 · SVG · 文档工具箱：45 个功能，全部本地离线处理",
  "main": "main.js",
  "author": "user",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "ensure-ffmpeg": "node scripts/ensure-ffmpeg.js",
    "postinstall": "node scripts/ensure-ffmpeg.js",
    "prepack": "node scripts/ensure-ffmpeg.js",
    "predist": "node scripts/ensure-ffmpeg.js",
    "pack": "electron-builder --win portable --dir",
    "dist": "electron-builder --win portable nsis",
    "release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release.ps1"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "adm-zip": "^0.6.1",
    "imagetracerjs": "^1.2.6",
    "svgo": "^4.1.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.local.video-gif-toolbox",
    "productName": "视频GIF工具箱",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "ffmpeg.js",
      "preload.js",
      "core/**/*",
      "modules/**/*",
      "renderer/**/*"
    ],
    "asarUnpack": [
      "node_modules/@resvg/**/*"
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin",
        "filter": [
          "ffmpeg.exe",
          "ffprobe.exe"
        ]
      }
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "视频GIF工具箱-${version}-便携版.exe"
    },
    "nsis": {
      "oneClick": true,
      "artifactName": "视频GIF工具箱-${version}-安装版.exe"
    }
  }
}
