---
import { app, data, repoUrl } from '../lib/site';

const faqs = [
  {
    q: '真的完全离线吗？会不会偷偷上传我的文件？',
    a: `是的，媒体处理完全离线。所有音视频、图片与文档处理都由安装包内置的 FFmpeg ${app.ffmpeg}、Resvg、SVGO 等组件在本机完成，软件没有任何服务器，也不需要账号。仅在两个用户主动触发的场景会联网：处理 Markdown 中引用的网络图片（仅访问图片本身地址）以及应用内手动检查热更新。源码完全公开，欢迎审查。`,
  },
  {
    q: '安装版和便携版怎么选？',
    a: '想长期使用，选安装版：会创建快捷方式，杀毒软件误报的概率也更低。想放在 U 盘里或临时用一下，选便携版：下载后双击就能运行。两个版本的功能完全一样。',
  },
  {
    q: '后续更新每次都要重新下载 130 MB 安装包吗？',
    a: '业务更新通常只有几百 KB，安装版和便携版都支持。应用会验证发布签名和文件校验值，启动异常时回滚。客户端壳升级需要下载完整程序。',
  },
  {
    q: '国内下载安装包比较慢怎么办？',
    a: '可以在上方下载区切换到「国内加速通道 1」或「国内加速通道 2」，页面会自动把安装版和便携版按钮切换成加速直链；也可以直接前往 GitHub Releases 页面下载并核对文件大小或校验值。',
  },
  {
    q: '打开时 Windows 提示“已保护你的电脑”怎么办？',
    a: '这是 Windows SmartScreen 对没有购买代码签名证书的新软件的常规提示，并不代表有病毒。点击“更多信息”，再点“仍要运行”即可。你也可以先到 GitHub Releases 页面核对文件的 SHA-256 校验值。',
  },
  {
    q: '支持 macOS 或 Linux 吗？',
    a: '目前只提供 Windows 10 / 11（64 位）安装包。软件基于 Electron 开发，理论上可以跨平台，如果你有需要，欢迎到 GitHub 提 Issue 告诉我们。',
  },
  {
    q: '处理速度怎么样？能用显卡加速吗？',
    a: '可以。在顶部的“硬件加速”里选择“自动检测 GPU”，就能启用 NVIDIA NVENC、Intel QSV 或 AMD AMF 硬件编码，视频转码通常能提速好几倍。如果遇到兼容问题，切回“CPU（最稳）”即可。',
  },
  {
    q: '会覆盖我的原文件吗？',
    a: '不会。处理结果默认保存在源文件所在的文件夹（也可以改成 output 子目录或自定义文件夹）。开启“防覆盖编号”后，同名文件会自动加上 _1、_2 后缀。',
  },
  {
    q: '单工具模式和节点画布模式有什么区别？',
    a: `单工具模式适合快速处理：选一个功能，拖入文件，点开始。节点画布适合多步骤的固定流程，例如“截取 → 加水印 → 转 GIF → 压缩 → 导出”，搭好一次之后可以反复使用，还能导出成 JSON 分享给别人。软件自带 ${data.stats.templates} 套开箱即用的模板。`,
  },
  {
    q: '收费吗？可以商用吗？',
    a: '完全免费，基于 MIT 协议开源，可以自由使用、修改和分发。如果觉得好用，欢迎到 GitHub 点个 Star。',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<section class="section" id="faq">
  <div class="container faq-wrap">
    <div class="section-head reveal">
      <div class="eyebrow">常见问题</div>
      <h2 class="h2">你可能想知道的</h2>
    </div>
    <div class="faq-list">
      {faqs.map((f, i) => (
        <details class="faq reveal" open={i === 0}>
          <summary>
            <span>{f.q}</span>
            <span class="faq-ico" aria-hidden="true"></span>
          </summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
    <p class="faq-more reveal">还有其他问题？<a href={`${repoUrl}/issues`} target="_blank" rel="noopener">到 GitHub Issues 提问 →</a></p>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
</section>

<style>
  .faq-wrap { max-width: 860px; }
  .faq-list { display: flex; flex-direction: column; gap: 10px; }
  .faq {
    border-radius: 14px; background: var(--surface); border: 1px solid var(--border);
    transition: border-color .2s, background .2s;
  }
  .faq[open] { border-color: var(--border-2); background: var(--surface-2); }
  .faq summary {
    list-style: none; cursor: pointer;
    display: flex; align-items: center; justify-content: space-between; gap: 16px;
    padding: 20px 22px; font-weight: 600; font-size: 16px;
  }
  .faq summary::-webkit-details-marker { display: none; }
  .faq-ico { position: relative; width: 14px; height: 14px; flex-shrink: 0; }
  .faq-ico::before, .faq-ico::after {
    content: ""; position: absolute; left: 0; right: 0; top: 50%; height: 1.8px; margin-top: -.9px;
    background: var(--text-2); border-radius: 2px; transition: transform .25s var(--ease);
  }
  .faq-ico::after { transform: rotate(90deg); }
  .faq[open] .faq-ico::after { transform: rotate(0deg); }
  .faq p { padding: 0 22px 20px; color: var(--text-2); font-size: 15px; line-height: 1.65; }
  .faq-more { margin-top: 28px; text-align: center; color: var(--text-3); font-size: 14px; }
  .faq-more a { color: var(--accent-hi); }
</style>
