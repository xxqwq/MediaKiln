---
// 运行时从 GitHub API 获取最新 Release，自动更新页面上的版本号、下载直链与文件大小。
// 请求失败（离线 / 限流）时保留构建时写入的版本与确定性直链，下载按钮仍然可用。
import { app } from '../lib/site';
---

<script is:inline define:vars={{ repo: app.repo }}>
  (() => {
    const applyMirror = (prefix) => {
      window.__vgtMirrorPrefix = prefix || '';
      document.querySelectorAll('[data-dl]').forEach((a) => {
        const raw = a.getAttribute('data-raw-url') || a.getAttribute('href') || '';
        if (!a.getAttribute('data-raw-url') && raw) a.setAttribute('data-raw-url', raw);
        if (raw) a.setAttribute('href', (prefix || '') + raw);
      });
    };
    window.__vgtApplyDlMirror = applyMirror;

    // 初始化所有下载按钮的原始 GitHub 直链
    document.querySelectorAll('[data-dl]').forEach((a) => {
      const href = a.getAttribute('href') || '';
      if (href && !a.getAttribute('data-raw-url')) a.setAttribute('data-raw-url', href);
    });

    (async () => {
      const CACHE_KEY = `vgt-preview-release:${repo}`;
      const TTL = 30 * 60 * 1000;
      let rel = null;
      try {
        const cached = JSON.parse(sessionStorage.getItem(CACHE_KEY) || 'null');
        if (cached && Date.now() - cached.t < TTL) rel = cached.v;
      } catch {}
      if (!rel) {
        try {
          const res = await fetch(`https://api.github.com/repos/${repo}/releases?per_page=10`, {
            headers: { Accept: 'application/vnd.github+json' },
          });
          if (!res.ok) return;
          const list = await res.json();
          const j = (Array.isArray(list) ? list : []).find((r) =>
            !r.draft && r.prerelease && /^v0\.\d+\.\d+$/.test(r.tag_name)
              && ['setup', 'portable'].every((kind) => (r.assets || []).some(
                (a) => a.name === `mediakiln-${r.tag_name.slice(1)}-${kind}.exe`
                  || a.name === `video-gif-toolbox-${r.tag_name.slice(1)}-${kind}.exe`,
              )));
          if (!j) return;
          rel = {
            tag: j.tag_name,
            date: j.published_at,
            assets: (j.assets || []).map((a) => ({
              name: a.name,
              label: a.label || '',
              size: a.size,
              url: a.browser_download_url,
            })),
          };
          sessionStorage.setItem(CACHE_KEY, JSON.stringify({ t: Date.now(), v: rel }));
        } catch {
          return;
        }
      }
      if (!rel || !/^v0\.\d+\.\d+$/.test(rel.tag)) return;

      const ver = rel.tag.replace(/^v/, '');
      document.querySelectorAll('[data-rel-version]').forEach((el) => { el.textContent = rel.tag; });
      document.querySelectorAll('[data-rel-version-num]').forEach((el) => { el.textContent = ver; });
      if (rel.date) {
        const d = new Date(rel.date);
        const txt = ` · ${d.getFullYear()} 年 ${d.getMonth() + 1} 月 ${d.getDate()} 日发布`;
        document.querySelectorAll('[data-rel-date]').forEach((el) => { el.textContent = txt; });
      }

      const fmtMb = (n) => (n > 0 ? `${(n / 1024 / 1024).toFixed(1)} MB` : '');
      const matchers = {
        setup: { name: /(-setup|安装版)\.exe$/i, label: /安装版/i },
        portable: { name: /(-portable|便携版)\.exe$/i, label: /便携版/i },
      };

      for (const kind of ['setup', 'portable']) {
        const m = matchers[kind];
        const asset = (rel.assets || []).find((a) => m.name.test(a.name) || m.label.test(a.label || ''));
        if (!asset) continue;
        document.querySelectorAll(`[data-dl="${kind}"]`).forEach((a) => {
          a.setAttribute('data-raw-url', asset.url);
        });
        document.querySelectorAll(`[data-dl-name="${kind}"]`).forEach((el) => {
          el.textContent = asset.label || asset.name;
        });
        document.querySelectorAll(`[data-dl-size="${kind}"]`).forEach((el) => {
          el.textContent = fmtMb(asset.size);
        });
      }
      applyMirror(window.__vgtMirrorPrefix || '');
    })();
  })();
</script>
