---
import { app, repoUrl, url } from '../lib/site';
import Logo from './Logo.astro';

const links = [
  { href: '#features', label: '核心亮点' },
  { href: '#why-local', label: '对比优势' },
  { href: '#workflow', label: '节点工作流' },
  { href: '#compare', label: '效果实测' },
  { href: '#all-features', label: '功能清单' },
  { href: '#faq', label: '常见问题' },
];
---

<header class="nav" id="top-nav">
  <div class="container nav-inner">
    <a class="brand" href={url('')} aria-label={`${app.name} 首页`}>
      <Logo size={30} />
      <span class="brand-name">{app.name}</span>
    </a>

    <nav class="nav-links" aria-label="主导航">
      {links.map((l) => <a href={l.href} data-nav-target={l.href.slice(1)}>{l.label}</a>)}
    </nav>

    <div class="nav-actions">
      <a class="gh-link" href={repoUrl} target="_blank" rel="noopener" aria-label="GitHub 开源仓库">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.53-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.68 0-1.25.45-2.28 1.19-3.08-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.8 1.19 1.83 1.19 3.08 0 4.41-2.7 5.38-5.26 5.67.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"/></svg>
        <span class="gh-label">GitHub</span>
      </a>
      <a class="btn btn-primary btn-sm nav-dl-btn" href="#download">免费下载</a>
      <button type="button" class="menu-btn" id="menu-btn" aria-label="打开菜单" aria-expanded="false" aria-controls="mobile-menu">
        <span></span><span></span>
      </button>
    </div>
  </div>
  <div class="mobile-menu" id="mobile-menu" hidden>
    {links.map((l) => <a href={l.href}>{l.label}</a>)}
    <a class="mobile-dl" href="#download">立即免费下载</a>
  </div>
</header>

<style>
  .nav {
    position: fixed; inset: 0 0 auto 0; z-index: 50;
    height: var(--nav-h);
    transition: background .25s, border-color .25s, backdrop-filter .25s;
    border-bottom: 1px solid transparent;
  }
  .nav.scrolled {
    background: rgba(11, 12, 16, .78);
    backdrop-filter: saturate(160%) blur(16px);
    -webkit-backdrop-filter: saturate(160%) blur(16px);
    border-bottom-color: var(--border);
  }
  .nav-inner { height: 100%; display: flex; align-items: center; gap: 24px; }
  .brand { display: flex; align-items: center; gap: 10px; font-weight: 700; font-size: 16px; flex-shrink: 0; }
  .nav-links { display: flex; gap: 2px; flex: 1; }
  .nav-links a {
    padding: 6px 12px; border-radius: 9px;
    font-size: 14px; color: var(--text-2);
    transition: color .2s, background .2s;
    white-space: nowrap;
  }
  .nav-links a:hover { color: var(--text); background: rgba(255, 255, 255, .05); }
  .nav-links a[data-active="true"] {
    color: #fff;
    background: var(--accent-soft);
    box-shadow: inset 0 0 0 1px rgba(124, 116, 255, .32);
  }
  .nav-actions { display: flex; align-items: center; gap: 10px; margin-left: auto; flex-shrink: 0; }
  .gh-link {
    display: inline-flex; align-items: center; gap: 7px;
    height: 36px; padding: 0 11px; border-radius: 10px;
    color: var(--text-2); font-size: 13.5px; font-weight: 500;
    border: 1px solid transparent;
    transition: color .2s, background .2s, border-color .2s;
  }
  .gh-link:hover { color: var(--text); background: rgba(255, 255, 255, .06); border-color: var(--border); }
  .nav-dl-btn { box-shadow: 0 6px 22px -6px rgba(124, 116, 255, .85), inset 0 1px 0 rgba(255, 255, 255, .28); }

  .menu-btn { display: none; width: 40px; height: 40px; border-radius: 10px; position: relative; }
  .menu-btn span {
    position: absolute; left: 11px; right: 11px; height: 1.6px; background: var(--text); border-radius: 2px;
    transition: transform .25s var(--ease), top .25s var(--ease);
  }
  .menu-btn span:first-child { top: 15px; }
  .menu-btn span:last-child { top: 23px; }
  .menu-btn[aria-expanded="true"] span:first-child { top: 19px; transform: rotate(45deg); }
  .menu-btn[aria-expanded="true"] span:last-child { top: 19px; transform: rotate(-45deg); }

  .mobile-menu {
    display: flex; flex-direction: column;
    padding: 8px 18px 18px;
    background: rgba(11, 12, 16, .96);
    backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--border);
  }
  .mobile-menu[hidden] { display: none; }
  .mobile-menu a { padding: 12px 4px; border-bottom: 1px solid var(--border); color: var(--text-2); font-size: 15px; }
  .mobile-menu a.mobile-dl {
    margin-top: 12px; border-bottom: 0; border-radius: 11px;
    padding: 11px 16px; text-align: center; font-weight: 600; color: #fff;
    background: linear-gradient(180deg, #918aff, var(--accent));
  }

  @media (max-width: 1080px) {
    .gh-label { display: none; }
    .gh-link { padding: 0 9px; }
  }
  @media (max-width: 960px) {
    .nav-links { display: none; }
    .menu-btn { display: block; }
  }
  @media (max-width: 420px) {
    .brand-name { display: none; }
  }
</style>

<script>
  const nav = document.getElementById('top-nav')!;
  const btn = document.getElementById('menu-btn')!;
  const menu = document.getElementById('mobile-menu')!;
  const navAnchors = Array.from(document.querySelectorAll<HTMLAnchorElement>('.nav-links a[data-nav-target]'));

  const setOpen = (open: boolean) => {
    btn.setAttribute('aria-expanded', String(open));
    menu.hidden = !open;
    nav.classList.toggle('scrolled', open || window.scrollY > 8);
  };
  btn.addEventListener('click', (e) => {
    e.stopPropagation();
    setOpen(menu.hidden);
  });
  menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  document.addEventListener('click', (e) => {
    if (!menu.hidden && !nav.contains(e.target as Node)) setOpen(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !menu.hidden) setOpen(false);
  });

  // Scroll-Spy：高亮当前阅读区域对应的导航项
  const targets = navAnchors
    .map((a) => ({ a, sec: document.getElementById(a.dataset.navTarget!) }))
    .filter((x): x is { a: HTMLAnchorElement; sec: HTMLElement } => !!x.sec);

  const updateSpy = () => {
    nav.classList.toggle('scrolled', !menu.hidden || window.scrollY > 8);
    const y = window.scrollY + 130;
    let current = '';
    for (const { a, sec } of targets) {
      if (sec.offsetTop <= y) current = a.dataset.navTarget!;
    }
    for (const { a } of targets) {
      a.dataset.active = String(a.dataset.navTarget === current);
    }
  };
  updateSpy();
  window.addEventListener('scroll', updateSpy, { passive: true });
</script>
