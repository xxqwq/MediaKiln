---
// 与桌面应用侧栏 Logo（renderer/index.html）一致的图形
interface Props { size?: number }
const { size = 32 } = Astro.props;
---

<span class="logo-badge" style={`width:${size}px;height:${size}px;border-radius:${Math.round(size * 0.3)}px`} aria-hidden="true">
  <svg viewBox="0 0 24 24" width={Math.round(size * 0.58)} height={Math.round(size * 0.58)} fill="none">
    <rect x="3" y="5" width="18" height="14" rx="3.5" stroke="currentColor" stroke-width="1.9" />
    <path d="M10.2 9.4v5.2a.5.5 0 0 0 .76.43l4.2-2.6a.5.5 0 0 0 0-.86l-4.2-2.6a.5.5 0 0 0-.76.43z" fill="currentColor" />
  </svg>
</span>

<style>
  .logo-badge {
    display: inline-grid; place-items: center; flex-shrink: 0;
    color: #fff;
    background: linear-gradient(135deg, #8d86ff 0%, #6a61f5 55%, #4fb3d9 120%);
    box-shadow: 0 6px 18px -6px rgba(124, 116, 255, .7), inset 0 1px 0 rgba(255, 255, 255, .3);
  }
</style>
