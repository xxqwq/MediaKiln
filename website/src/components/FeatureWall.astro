---
import { data } from '../lib/site';
import { iconSvg } from '../lib/icons';

const groups = data.groupOrder.filter((g) => data.features.some((f) => f.group === g));
const groupMeta = data.groupMeta as Record<string, { color: string; icon: string }>;
const countOf = (g: string) => data.features.filter((f) => f.group === g).length;

const groupIndex = new Map(groups.map((g, i) => [g, i]));
const orderedFeatures = [...data.features].sort(
  (a, b) => (groupIndex.get(a.group) ?? 99) - (groupIndex.get(b.group) ?? 99),
);

// 折叠默认态：从 8 大分类各精选 2 个代表性功能（共 16 项），确保所有品类一屏可见
const featuredIds = new Set<string>();
for (const g of groups) {
  orderedFeatures
    .filter((f) => f.group === g)
    .slice(0, 2)
    .forEach((f) => featuredIds.add(f.id));
}

const fmtAccept = (acc: string[]) => {
  const uniq = Array.from(new Set(acc.map((e) => (e === 'jpeg' ? 'jpg' : e === 'markdown' ? 'md' : e))));
  return uniq.length > 6 ? `${uniq.slice(0, 6).join(' · ')} 等 ${uniq.length} 种` : uniq.join(' · ');
};

const hotWords = ['GIF', 'APNG', 'PDF', '音频', 'PPT', '抠图', 'SVG', '水印'];
---

<section class="section" id="all-features">
  <div class="container">
    <div class="section-head-split reveal">
      <div class="sh-left">
        <div class="eyebrow">完整功能清单</div>
        <h2 class="h2">{data.stats.features} 个功能，<span class="grad-text">{groups.length} 大分类</span></h2>
      </div>
      <p class="lead">清单直接取自软件的功能注册表，软件更新后这里也会自动同步。</p>
    </div>

    <div class="fw-toolbar reveal">
      <div class="fw-search">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
        <input id="fw-q" type="search" placeholder="搜索功能，例如：GIF、PPT、抠图、微信…" autocomplete="off" aria-label="搜索功能" />
        <button type="button" class="fw-clear" id="fw-clear" hidden aria-label="清空搜索" title="清空">×</button>
        <kbd title="按 / 键快速聚焦搜索框">/</kbd>
      </div>
      <div class="fw-hot" aria-label="热门搜索">
        {hotWords.map((w) => <button type="button" class="fw-hot-btn" aria-pressed="false" data-q={w}>{w}</button>)}
      </div>
      <div class="fw-groups" role="group" aria-label="按分类筛选">
        <button type="button" class="chip" aria-pressed="true" data-group="">全部 <span class="count">{orderedFeatures.length}</span></button>
        {groups.map((g) => (
          <button type="button" class="chip" aria-pressed="false" data-group={g}>
            <span class="chip-ico" style={`color:${groupMeta[g]?.color || '#94a3b8'}`} set:html={iconSvg(groupMeta[g]?.icon || '', 14)} />
            <span>{g}</span>
            <span class="count">{countOf(g)}</span>
          </button>
        ))}
      </div>
      <p class="fw-status" id="fw-status" aria-live="polite"></p>
    </div>

    <div class="fw-grid" id="fw-grid" data-total={orderedFeatures.length} data-featured={featuredIds.size}>
      {orderedFeatures.map((f) => (
        <article
          class="fw-card"
          data-group={f.group}
          data-featured={featuredIds.has(f.id) ? 'true' : 'false'}
          data-search={`${f.name} ${f.desc} ${f.group} ${f.accept.join(' ')}`.toLowerCase()}
          style={`--gc: ${groupMeta[f.group]?.color || '#94a3b8'}`}
        >
          <div class="fw-head">
            <span class="fw-icon" set:html={iconSvg(f.icon, 17)} />
            <h3 class="fw-name">{f.name}</h3>
          </div>
          <p class="fw-desc">{f.desc}</p>
          <div class="fw-foot">
            <span class="fw-group">{f.group}</span>
            {f.batch && <span class="tag t-batch" title="支持多文件批量队列">批量</span>}
            {f.multi && <span class="tag t-multi" title="多个文件合并为一个输出">多文件合成</span>}
            {f.noBatch && <span class="tag" title="需要在预览图上交互操作">交互</span>}
            <span class="fw-ext" title={f.accept.join(', ')}>{fmtAccept(f.accept)}</span>
          </div>
        </article>
      ))}
    </div>
    <div class="fw-empty" id="fw-empty" hidden>
      <p>没有找到匹配的功能，换个关键词或清空筛选试试？</p>
      <button type="button" class="btn btn-ghost btn-sm" id="fw-reset">重置筛选条件</button>
    </div>
    <div class="fw-more" id="fw-more-wrap">
      <button type="button" class="btn btn-ghost" id="fw-more" aria-controls="fw-grid" aria-expanded="false">
        展开全部 {orderedFeatures.length} 个功能 ↓
      </button>
    </div>
  </div>
</section>

<style>
  .fw-toolbar { display: flex; flex-direction: column; align-items: center; gap: 14px; margin-bottom: 28px; }
  .fw-search {
    width: 100%; max-width: 560px; height: 52px;
    display: flex; align-items: center; gap: 10px; padding: 0 14px 0 16px;
    border-radius: 14px; background: var(--surface); border: 1px solid var(--border-2);
    color: var(--text-3);
    transition: border-color .2s, box-shadow .2s;
  }
  .fw-search:focus-within { border-color: var(--accent-ring); box-shadow: 0 0 0 4px rgba(124, 116, 255, .12); }
  .fw-search input { flex: 1; min-width: 0; height: 100%; background: none; border: 0; outline: none; font-size: 15.5px; color: var(--text); }
  .fw-search input::placeholder { color: var(--text-3); }
  .fw-search input::-webkit-search-cancel-button { display: none; }
  .fw-clear {
    width: 24px; height: 24px; border-radius: 50%;
    display: grid; place-items: center; font-size: 16px; line-height: 1;
    color: var(--text-2); background: rgba(255, 255, 255, .08);
    transition: background .2s, color .2s;
  }
  .fw-clear[hidden] { display: none; }
  .fw-clear:hover { background: rgba(255, 255, 255, .16); color: #fff; }
  .fw-search kbd {
    font-family: var(--mono); font-size: 12px; padding: 2px 7px; border-radius: 6px;
    border: 1px solid var(--border-2); color: var(--text-3);
  }
  .fw-hot { display: flex; flex-wrap: wrap; justify-content: center; gap: 6px 12px; font-size: 13px; color: var(--text-3); }
  .fw-hot-btn {
    color: var(--text-3); padding: 3px 8px; border-radius: 999px;
    border: 1px solid transparent; transition: color .2s, background .2s, border-color .2s;
  }
  .fw-hot-btn:hover { color: var(--accent-hi); }
  .fw-hot-btn[aria-pressed="true"] {
    color: #fff; background: var(--accent-soft); border-color: rgba(124, 116, 255, .36);
  }
  .fw-hot-btn::before { content: "#"; opacity: .5; margin-right: 2px; }
  .fw-groups { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; }
  .chip-ico { display: inline-flex; align-items: center; }
  .fw-status { font-size: 13px; color: var(--text-3); min-height: 20px; }

  .fw-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(270px, 1fr)); gap: 14px; }
  .fw-card {
    position: relative; padding: 20px 20px 16px; border-radius: 14px;
    background: var(--surface); border: 1px solid var(--border);
    display: flex; flex-direction: column;
    transition: border-color .2s, transform .2s var(--ease), background .2s;
  }
  .fw-card::before {
    content: ""; position: absolute; left: 20px; right: 20px; top: 0; height: 2px; border-radius: 2px;
    background: var(--gc); opacity: .62;
  }
  .fw-card:hover { border-color: var(--border-3); transform: translateY(-2px); background: var(--surface-2); }
  .fw-card[hidden] { display: none; }
  .fw-head { display: flex; align-items: center; gap: 10px; }
  .fw-icon {
    width: 34px; height: 34px; display: grid; place-items: center; border-radius: 10px; flex-shrink: 0;
    color: var(--gc);
    background: rgba(255, 255, 255, .04);
    background: color-mix(in srgb, var(--gc) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--gc) 25%, rgba(255, 255, 255, .08));
  }
  .fw-name { font-size: 15.5px; font-weight: 650; line-height: 1.35; }
  .fw-desc { margin-top: 10px; font-size: 13.5px; color: var(--text-2); line-height: 1.6; flex: 1; }
  .fw-foot { margin-top: 14px; display: flex; flex-wrap: wrap; align-items: center; gap: 6px; }
  .fw-group { font-size: 12px; color: var(--gc); margin-right: 2px; }
  .fw-foot .tag { height: 20px; font-size: 11.5px; padding: 0 7px; }
  .t-batch { color: #b9f5d6; border-color: rgba(61, 214, 140, .3); background: rgba(61, 214, 140, .08); }
  .t-multi { color: #d6d3ff; border-color: rgba(124, 116, 255, .3); background: var(--accent-soft); }
  .fw-ext { margin-left: auto; font-size: 11.5px; color: var(--text-3); font-family: var(--mono); text-transform: uppercase; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 100%; }

  .fw-empty { text-align: center; color: var(--text-3); padding: 44px 0; display: flex; flex-direction: column; align-items: center; gap: 14px; }
  .fw-empty[hidden] { display: none; }
  .fw-more { position: relative; display: flex; justify-content: center; margin-top: 28px; }
  .fw-more[hidden] { display: none; }
</style>

<script>
  const q = document.getElementById('fw-q') as HTMLInputElement;
  const clearBtn = document.getElementById('fw-clear')!;
  const resetBtn = document.getElementById('fw-reset')!;
  const statusEl = document.getElementById('fw-status')!;
  const grid = document.getElementById('fw-grid')!;
  const cards = Array.from(document.querySelectorAll<HTMLElement>('.fw-card'));
  const groupBtns = document.querySelectorAll<HTMLButtonElement>('.fw-groups [data-group]');
  const hotBtns = document.querySelectorAll<HTMLButtonElement>('.fw-hot-btn');
  const empty = document.getElementById('fw-empty')!;
  const moreWrap = document.getElementById('fw-more-wrap')!;
  const moreBtn = document.getElementById('fw-more')!;
  const totalCount = Number(grid.dataset.total || cards.length);
  const featuredCount = Number(grid.dataset.featured || 16);

  let group = '';
  let expanded = false;

  const apply = () => {
    const raw = q.value.trim();
    const terms = raw.toLowerCase().split(/\s+/).filter(Boolean);
    const filtering = !!group || terms.length > 0;
    const collapsedView = !filtering && !expanded;

    clearBtn.hidden = raw.length === 0;
    hotBtns.forEach((b) => b.setAttribute('aria-pressed', String(raw.toLowerCase() === (b.dataset.q || '').toLowerCase())));

    let matched = 0;
    let visible = 0;
    for (const c of cards) {
      const okGroup = !group || c.dataset.group === group;
      const okText = terms.every((t) => c.dataset.search!.includes(t));
      const match = okGroup && okText;
      if (match) matched++;
      const show = match && (!collapsedView || c.dataset.featured === 'true');
      c.hidden = !show;
      if (show) visible++;
    }

    empty.hidden = matched > 0;
    moreWrap.hidden = filtering || matched === 0;
    moreBtn.setAttribute('aria-expanded', String(expanded));
    moreBtn.textContent = expanded
      ? '收起为 8 大类精选视图 ↑'
      : `展开全部 ${totalCount} 个功能 ↓`;

    if (filtering) {
      statusEl.textContent = `当前筛选共匹配 ${matched} 个功能`;
    } else if (collapsedView) {
      statusEl.textContent = `已从 8 大类各精选 2 项代表功能（展示 ${visible} / ${totalCount} 项）`;
    } else {
      statusEl.textContent = `正在展示全部 ${totalCount} 个功能`;
    }
  };

  moreBtn.addEventListener('click', () => {
    expanded = !expanded;
    apply();
    if (!expanded) {
      document.getElementById('all-features')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  });

  groupBtns.forEach((b) => b.addEventListener('click', () => {
    group = b.dataset.group || '';
    groupBtns.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    apply();
  }));

  q.addEventListener('input', apply);

  clearBtn.addEventListener('click', () => {
    q.value = '';
    apply();
    q.focus();
  });

  resetBtn.addEventListener('click', () => {
    q.value = '';
    group = '';
    groupBtns.forEach((x) => x.setAttribute('aria-pressed', String(x.dataset.group === '')));
    apply();
  });

  hotBtns.forEach((b) => b.addEventListener('click', () => {
    const w = b.dataset.q || '';
    q.value = q.value.trim().toLowerCase() === w.toLowerCase() ? '' : w;
    apply();
  }));

  document.addEventListener('keydown', (e) => {
    const t = e.target as HTMLElement;
    if (e.key === '/' && !['INPUT', 'TEXTAREA'].includes(t.tagName)) {
      e.preventDefault();
      q.focus();
      q.scrollIntoView({ block: 'center', behavior: 'smooth' });
    }
  });

  apply();
</script>
