---
import { app, data, url, hasAsset, assetUrl, assetSize, fmtBytes, releasesUrl, dlVersion } from '../lib/site';
import { iconSvg } from '../lib/icons';

const shots = [
  {
    id: 'single',
    icon: 'wrench',
    label: '单工具模式',
    file: 'screenshots/single-video-to-gif.webp',
    caption: '左侧 8 大分类即点即用，右侧实时视频预览、多档/按比例/自定义宽度与两遍调色板高清转码',
    alt: '单工具模式：视频转 GIF 界面，左侧为 8 大类功能导航，右侧为预览与参数面板',
  },
  {
    id: 'workflow',
    icon: 'workflow',
    label: '节点画布工作流',
    file: 'screenshots/workflow-canvas.webp',
    caption: '多步骤自由连线、分支前后对比与增量智能缓存，调整下游参数秒级命中',
    alt: '节点画布模式：视频截取、加水印、转 GIF、压缩并分支对比的工作流',
  },
  {
    id: 'batch',
    icon: 'package',
    label: '批量队列处理',
    file: 'screenshots/batch-queue.webp',
    caption: '支持多文件队列与图片缩略图网格预览，实时显示每个文件的压缩率与总体瘦身结果',
    alt: '批量队列处理完成后的界面截图，显示每个文件的体积变化',
  },
  {
    id: 'compare',
    icon: 'maximize',
    label: '卷帘放大对比',
    file: 'screenshots/single-result-compare.webp',
    caption: '处理结果支持 100%～400% 同步缩放平移与透明棋盘格卷帘细节检视',
    alt: '处理完成后的放大对比弹窗，支持并排同步缩放与卷帘对比',
  },
].filter((s) => hasAsset(s.file));

const s = data.stats;
---

<section class="hero" id="hero">
  <div class="hero-bg" aria-hidden="true">
    <div class="glow g1"></div>
    <div class="glow g2"></div>
    <div class="beam"></div>
    <div class="grid"></div>
  </div>

  <div class="container hero-inner">
    <a class="badge fade-up" style="--d:0ms" href={releasesUrl} target="_blank" rel="noopener">
      <span class="badge-dot"></span>
      <span data-rel-version>v{dlVersion}</span> 公开测试版
      <span class="badge-sep"></span>
      <span class="muted">查看更新日志 →</span>
    </a>

    <h1 class="hero-title fade-up" style="--d:60ms">
      视频、GIF、图片与文档<br />
      <span class="grad-text">在你自己的电脑上一站搞定</span>
    </h1>

    <p class="hero-sub fade-up" style="--d:120ms">
      {s.features} 项全能处理 · {s.nodes} 节点可视化流水线 · 内置 FFmpeg {app.ffmpeg}。<br />
      <strong>断网可用、文件永不离开电脑</strong>，免费开源、无广告无体积限制。
    </p>

    <div class="hero-cta fade-up" style="--d:180ms">
      <a class="btn btn-primary btn-stack" href={assetUrl('setup')} data-dl="setup">
        <span>
          <svg viewBox="0 0 24 24" width="17" height="17" fill="currentColor" aria-hidden="true" style="display:inline;vertical-align:-3px;margin-right:6px"><path d="M3 5.5 10.5 4.5v7H3v-6Zm8.5-1.15L21 3v8.5h-9.5V4.35ZM3 12.5h7.5v7L3 18.5v-6Zm8.5 0H21V21l-9.5-1.35V12.5Z"/></svg>下载 Windows 安装版
        </span>
        <span class="sub">v<span data-rel-version-num>{dlVersion}</span> · Win10 / 11 x64<span class="dl-size-dot" data-dl-size="setup">{assetSize('setup') ? fmtBytes(assetSize('setup')) : ''}</span></span>
      </a>
      <a class="btn btn-ghost btn-stack" href={assetUrl('portable')} data-dl="portable">
        <span>免安装便携版</span>
        <span class="sub">单个 exe，双击即用<span class="dl-size-dot" data-dl-size="portable">{assetSize('portable') ? fmtBytes(assetSize('portable')) : ''}</span></span>
      </a>
    </div>

    <div class="hero-meta fade-up" style="--d:230ms">
      <ul class="hero-points" aria-label="核心卖点">
        <li><span class="ck" set:html={iconSvg('check', 13)} />100% 本地离线</li>
        <li><span class="ck" set:html={iconSvg('check', 13)} />{s.batchFeatures} 项支持批量</li>
        <li><span class="ck" set:html={iconSvg('check', 13)} />NVENC / QSV / AMF 硬件加速</li>
        <li><span class="ck" set:html={iconSvg('check', 13)} />MIT 开源</li>
      </ul>
      <a class="hero-browse" href="#all-features">浏览全部 {s.features} 个功能 ↓</a>
    </div>

    {shots.length > 0 && (
      <div class="hero-shot fade-up is-auto" id="hero-shot" style="--d:310ms">
        {shots.length > 1 && (
          <div class="shot-tabs" role="tablist" aria-label="界面预览">
            {shots.map((sh, i) => (
              <button
                type="button"
                class="chip shot-tab"
                role="tab"
                id={`shot-tab-${sh.id}`}
                aria-controls={`shot-${sh.id}`}
                aria-selected={i === 0 ? 'true' : 'false'}
                data-shot={sh.id}
                data-caption={sh.caption}
              >
                <Fragment set:html={iconSvg(sh.icon, 14)} />
                <span>{sh.label}</span>
                <span class="shot-bar" aria-hidden="true"><i></i></span>
              </button>
            ))}
          </div>
        )}
        <div class="window">
          <div class="window-bar">
            <span class="dots"><i></i><i></i><i></i></span>
            <span class="title">{app.name}</span>
            <span class="win-right">
              <span class="win-pill"><Fragment set:html={iconSvg('lock', 12)} /><span>本机离线引擎 · 0 上传</span></span>
              <span class="win-zoom-hint"><Fragment set:html={iconSvg('zoomIn', 12)} /><span>点击大图</span></span>
            </span>
          </div>
          <div class="window-body shot-stack">
            {shots.map((sh, i) => (
              <img
                id={`shot-${sh.id}`}
                role="tabpanel"
                aria-labelledby={`shot-tab-${sh.id}`}
                src={url(sh.file)}
                alt={sh.alt}
                data-caption={sh.caption}
                data-zoomable
                width="1440"
                height="900"
                loading={i === 0 ? 'eager' : 'lazy'}
                fetchpriority={i === 0 ? 'high' : 'auto'}
                class:list={['shot', { active: i === 0 }]}
              />
            ))}
          </div>
        </div>
        <p class="shot-caption" id="shot-caption">{shots[0].caption}</p>
      </div>
    )}
  </div>
</section>

<style>
  .hero { position: relative; padding: calc(var(--nav-h) + 64px) 0 42px; overflow: hidden; }
  .hero-bg { position: absolute; inset: 0; pointer-events: none; }
  .glow { position: absolute; border-radius: 50%; filter: blur(95px); opacity: .58; }
  .g1 { width: 760px; height: 520px; left: 50%; top: -220px; transform: translateX(-60%); background: radial-gradient(closest-side, rgba(124, 116, 255, .56), transparent); }
  .g2 { width: 540px; height: 430px; left: 56%; top: 30px; background: radial-gradient(closest-side, rgba(103, 199, 230, .28), transparent); }
  .beam {
    position: absolute; left: 50%; top: -40px; transform: translateX(-50%);
    width: min(1100px, 92vw); height: 340px;
    background: conic-gradient(from 90deg at 50% 0%, transparent 155deg, rgba(139, 132, 255, .14) 176deg, rgba(103, 199, 230, .09) 186deg, transparent 206deg);
    filter: blur(28px);
    opacity: .72;
  }
  .grid {
    position: absolute; inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, .036) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, .036) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: radial-gradient(ellipse 75% 58% at 50% 18%, #000 30%, transparent 78%);
    -webkit-mask-image: radial-gradient(ellipse 75% 58% at 50% 18%, #000 30%, transparent 78%);
  }

  .hero-inner { position: relative; text-align: center; display: flex; flex-direction: column; align-items: center; }

  .badge {
    display: inline-flex; align-items: center; gap: 10px;
    height: 34px; padding: 0 14px;
    border-radius: 999px;
    background: rgba(255, 255, 255, .045);
    border: 1px solid var(--border-2);
    font-size: 13px;
    transition: border-color .2s, background .2s;
  }
  .badge:hover { border-color: var(--accent-ring); background: var(--accent-soft); }
  .badge-dot {
    width: 7px; height: 7px; border-radius: 50%;
    background: var(--success);
    box-shadow: 0 0 0 4px rgba(61, 214, 140, .18);
    animation: pulse-dot 2.4s ease-in-out infinite;
  }
  @keyframes pulse-dot {
    0%, 100% { box-shadow: 0 0 0 3px rgba(61, 214, 140, .20); }
    50% { box-shadow: 0 0 0 6px rgba(61, 214, 140, .06); }
  }
  .badge-sep { width: 1px; height: 14px; background: var(--border-3); }
  .muted { color: var(--text-2); }

  .hero-title {
    margin-top: 26px;
    font-family: var(--font-display);
    font-size: clamp(38px, 6.2vw, 70px);
    line-height: 1.12;
    font-weight: 800;
    letter-spacing: -.022em;
  }
  .hero-sub { margin-top: 20px; max-width: 700px; font-size: clamp(16px, 1.55vw, 18.5px); color: var(--text-2); text-wrap: balance; }
  .hero-sub strong { color: var(--text); font-weight: 600; white-space: nowrap; }

  .hero-cta { margin-top: 32px; display: flex; gap: 14px; flex-wrap: wrap; justify-content: center; }
  .hero-cta .btn { min-width: 232px; }
  .dl-size-dot:not(:empty)::before { content: " · "; }

  .hero-meta { margin-top: 24px; display: flex; flex-direction: column; align-items: center; gap: 10px; }
  .hero-points {
    list-style: none;
    display: flex; flex-wrap: wrap; justify-content: center; gap: 8px 24px;
    font-size: 13.5px; color: var(--text-2);
  }
  .hero-points li { display: flex; align-items: center; gap: 6px; }
  .ck { color: var(--success); display: inline-flex; align-items: center; }
  .hero-browse { font-size: 13.5px; color: var(--accent-hi); transition: color .2s; }
  .hero-browse:hover { color: #fff; text-decoration: underline; text-underline-offset: 4px; }

  .hero-shot { margin-top: 48px; width: 100%; max-width: 1120px; }
  .shot-tabs { display: flex; justify-content: center; flex-wrap: wrap; gap: 8px; margin-bottom: 18px; }
  .shot-tab { position: relative; overflow: hidden; padding: 0 15px; height: 36px; }
  .shot-bar {
    position: absolute; left: 10px; right: 10px; bottom: 0; height: 2px;
    border-radius: 2px; overflow: hidden; opacity: 0;
  }
  .shot-bar i { display: block; width: 100%; height: 100%; background: linear-gradient(90deg, var(--accent-hi), var(--accent-2)); transform: scaleX(0); transform-origin: left; }
  .hero-shot.is-auto .shot-tab[aria-selected="true"] .shot-bar { opacity: 1; }
  .hero-shot.is-auto .shot-tab[aria-selected="true"] .shot-bar i { animation: tab-progress 5.5s linear infinite; }
  .hero-shot.is-paused .shot-tab[aria-selected="true"] .shot-bar i { animation-play-state: paused; }
  @keyframes tab-progress { from { transform: scaleX(0); } to { transform: scaleX(1); } }

  .window-bar { position: relative; }
  .window-bar .title { text-align: center; }
  .win-right { display: flex; align-items: center; gap: 8px; flex-shrink: 0; }
  .win-pill {
    display: inline-flex; align-items: center; gap: 5px;
    font-size: 11.5px; color: #b9f5d6; padding: 2px 9px; border-radius: 999px;
    background: rgba(61, 214, 140, .10); border: 1px solid rgba(61, 214, 140, .25);
    white-space: nowrap;
  }
  .win-zoom-hint {
    display: inline-flex; align-items: center; gap: 5px;
    font-size: 11.5px; color: var(--text-3); padding: 2px 9px; border-radius: 6px;
    background: rgba(255, 255, 255, .04); border: 1px solid var(--border);
    white-space: nowrap;
  }

  .shot-stack { display: grid; }
  .shot { grid-area: 1 / 1; opacity: 0; pointer-events: none; transition: opacity .42s var(--ease); }
  .shot.active { opacity: 1; pointer-events: auto; }
  .shot-caption { margin-top: 14px; font-size: 13.5px; color: var(--text-2); }

  @media (max-width: 720px) {
    .hero { padding-top: calc(var(--nav-h) + 42px); }
    .hero-title br, .hero-sub br { display: none; }
    .hero-cta { width: 100%; }
    .hero-cta .btn { width: 100%; }
    .hero-shot { margin-top: 38px; }
    .win-pill, .win-zoom-hint { display: none; }
  }
</style>

<script>
  const heroShot = document.getElementById('hero-shot');
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.shot-tabs [data-shot]'));
  const capEl = document.getElementById('shot-caption');
  let timer: number | undefined;
  let cur = 0;

  const select = (id: string) => {
    tabs.forEach((t, idx) => {
      const active = t.dataset.shot === id;
      t.setAttribute('aria-selected', String(active));
      if (active) {
        cur = idx;
        if (capEl && t.dataset.caption) capEl.textContent = t.dataset.caption;
      }
    });
    document.querySelectorAll('.shot-stack .shot').forEach((img) => {
      img.classList.toggle('active', img.id === `shot-${id}`);
    });
  };

  const stopAuto = () => {
    window.clearInterval(timer);
    timer = undefined;
    heroShot?.classList.remove('is-auto');
  };

  const startAuto = () => {
    if (tabs.length <= 1 || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    window.clearInterval(timer);
    timer = window.setInterval(() => {
      cur = (cur + 1) % tabs.length;
      select(tabs[cur].dataset.shot!);
    }, 5500);
  };

  tabs.forEach((t) => t.addEventListener('click', () => {
    stopAuto();
    select(t.dataset.shot!);
  }));

  if (heroShot && tabs.length > 1 && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    startAuto();
    heroShot.addEventListener('mouseenter', () => {
      heroShot.classList.add('is-paused');
      window.clearInterval(timer);
    });
    heroShot.addEventListener('mouseleave', () => {
      if (heroShot.classList.contains('is-auto')) {
        heroShot.classList.remove('is-paused');
        startAuto();
      }
    });
  } else {
    heroShot?.classList.remove('is-auto');
  }
</script>
