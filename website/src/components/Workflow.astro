---
import { data, url, hasAsset } from '../lib/site';

const HEAD_H = 48;
const PORT_H = 28;
const PAD_B = 12;
const COL_GAP = 86;

const groupMeta = data.groupMeta as Record<string, { color: string; icon: string }>;
const portTypes = data.portTypes as Record<string, { label: string; color: string }>;
const colorOf = (g: string) => groupMeta[g]?.color || '#94a3b8';
const portColor = (type?: string, group?: string) => (type && portTypes[type]?.color) || colorOf(group || '');
const shortLabel = (s: string) => s.replace(/\(可选\)|（可选）/g, '').trim();

function estimateTextW(text: string, cjkPx: number, asciiPx: number) {
  let w = 0;
  for (const ch of text) {
    w += /[\u4e00-\u9fff\u3000-\u303f\uff00-\uffef]/.test(ch) ? cjkPx : asciiPx;
  }
  return w;
}

function calcNodeWidth(n: { name: string; inputs: { label: string }[]; outputs: { label: string }[] }) {
  // 标题：17.5px 加粗 + 图标区 28px + 左右内边距 36px
  const titleW = estimateTextW(n.name, 18.2, 10.2) + 28 + 38;
  const maxIn = Math.max(0, ...n.inputs.map((p) => estimateTextW(shortLabel(p.label), 14.5, 8.2)));
  const maxOut = Math.max(0, ...n.outputs.map((p) => estimateTextW(shortLabel(p.label), 14.5, 8.2)));
  const portW = maxIn + maxOut + (maxIn && maxOut ? 56 : 44);
  return Math.round(Math.max(248, Math.min(352, Math.max(titleW, portW))));
}

const templates = data.templates.map((t, i) => {
  // 1. 按原始 x 聚类成离散列，避免列距过窄导致拥挤
  const sortedXs = Array.from(new Set(t.graph.nodes.map((n) => n.x))).sort((a, b) => a - b);
  const colClusters: number[] = [];
  for (const x of sortedXs) {
    if (!colClusters.length || x - colClusters[colClusters.length - 1] > 60) {
      colClusters.push(x);
    }
  }
  const colOf = (x: number) => {
    let best = 0;
    let dist = Infinity;
    colClusters.forEach((cx, ci) => {
      const d = Math.abs(x - cx);
      if (d < dist) { dist = d; best = ci; }
    });
    return best;
  };

  const preNodes = t.graph.nodes.map((n) => {
    const rows = Math.max(n.inputs.length, n.outputs.length, 1);
    const w = calcNodeWidth(n);
    const h = HEAD_H + rows * PORT_H + PAD_B;
    return { ...n, col: colOf(n.x), w, h };
  });

  const colWidths = colClusters.map((_, ci) =>
    Math.max(248, ...preNodes.filter((n) => n.col === ci).map((n) => n.w)),
  );
  const colX: number[] = [];
  let curX = 28;
  colWidths.forEach((cw, ci) => {
    colX[ci] = curX;
    curX += cw + COL_GAP;
  });

  const nodes = preNodes.map((n) => ({ ...n, x: colX[n.col] }));
  const byId = new Map(nodes.map((n) => [n.id, n]));
  const portY = (n: (typeof nodes)[number], idx: number) => n.y + HEAD_H + idx * PORT_H + PORT_H / 2 - 4;

  const arcExtremesY: number[] = [];
  const edges = t.graph.edges
    .filter((e) => byId.has(e.from) && byId.has(e.to))
    .map((e) => {
      const a = byId.get(e.from)!;
      const b = byId.get(e.to)!;
      const ai = Math.max(0, a.outputs.findIndex((p) => p.id === e.fromPort));
      const bi = Math.max(0, b.inputs.findIndex((p) => p.id === e.toPort));
      const srcPort = a.outputs[ai];
      const x1 = a.x + a.w;
      const y1 = portY(a, ai);
      const x2 = b.x;
      const y2 = portY(b, bi);
      const col = portColor((srcPort as { type?: string } | undefined)?.type, a.group);

      // 检测跨列连线是否会穿过中间列节点的身体，若是则改为从上方或下方平滑绕行
      let d = '';
      if (b.col - a.col > 1) {
        const between = nodes.filter((n) => n.col > a.col && n.col < b.col);
        const minLineY = Math.min(y1, y2);
        const maxLineY = Math.max(y1, y2);
        const blockers = between.filter((n) => n.y - 16 <= maxLineY && n.y + n.h + 16 >= minLineY);
        if (blockers.length > 0) {
          const topClear = Math.min(...between.map((n) => n.y), y1, y2) - 46;
          const botClear = Math.max(...between.map((n) => n.y + n.h), y1, y2) + 46;
          const midY = (y1 + y2) / 2;
          const arcY = Math.abs(midY - topClear) <= Math.abs(botClear - midY) ? topClear : botClear;
          const midX = (x1 + x2) / 2;
          const span = Math.max(80, x2 - x1);
          const endOff = Math.max(60, span * 0.12);
          const midOff = Math.max(90, span * 0.34);
          arcExtremesY.push(arcY);
          d = `M${x1},${y1} C${x1 + endOff},${y1} ${midX - midOff},${arcY} ${midX},${arcY} C${midX + midOff},${arcY} ${x2 - endOff},${y2} ${x2},${y2}`;
        }
      }
      if (!d) {
        const dx = Math.max(48, Math.abs(x2 - x1) * 0.48);
        d = `M${x1},${y1} C${x1 + dx},${y1} ${x2 - dx},${y2} ${x2},${y2}`;
      }
      return { d, color: col };
    });

  const minX = Math.min(...nodes.map((n) => n.x)) - 26;
  const minY = Math.min(...nodes.map((n) => n.y), ...arcExtremesY) - 24;
  const maxX = Math.max(...nodes.map((n) => n.x + n.w)) + 26;
  const maxY = Math.max(...nodes.map((n) => n.y + n.h), ...arcExtremesY) + 24;
  const shot = [`screenshots/wf-${t.id}.webp`, `screenshots/wf-template-${i}.webp`].find(hasAsset) || null;

  // 生成供速览的有序步骤链（按列再按纵坐标排序）
  const steps = [...nodes]
    .sort((a, b) => a.col - b.col || a.y - b.y)
    .map((n) => ({ icon: n.icon, name: n.name, color: colorOf(n.group) }));

  return {
    ...t,
    title: t.name.replace(/^\p{Extended_Pictographic}\uFE0F?\s*/u, ''),
    emoji: (t.name.match(/^\p{Extended_Pictographic}\uFE0F?/u) || ['🧩'])[0],
    nodes, edges, portY, steps,
    viewBox: `${minX} ${minY} ${maxX - minX} ${maxY - minY}`,
    shot,
  };
});

const legendPorts = ['video', 'gif', 'image', 'svg', 'doc', 'audio']
  .map((k) => ({ key: k, ...portTypes[k] }))
  .filter((x) => x.label);

const anyShot = templates.some((t) => t.shot);
const s = data.stats;
---

<section class="section wf-section" id="workflow">
  <div class="container">
    <div class="section-head reveal">
      <div class="eyebrow">节点画布模式</div>
      <h2 class="h2">像搭积木一样，<span class="grad-text">串起整条处理流程</span></h2>
      <p class="lead">
        {s.nodes} 个节点（{s.ioNodes} 个输入输出节点和 {s.nodes - s.ioNodes} 个功能节点）可自由连线。支持类型校验、按格式分流、分支对比、节点旁路与增量缓存。下面是软件内置的 {s.templates} 套模板：
      </p>
    </div>

    <div class="wf-tabs reveal" role="tablist" aria-label="预设工作流模板">
      {templates.map((t, i) => (
        <button type="button" class="wf-tab" role="tab" id={`wf-tab-${i}`} aria-controls={`wf-panel-${i}`} aria-selected={i === 0 ? 'true' : 'false'} data-wf={i}>
          <span class="wf-emoji">{t.emoji}</span>
          <span class="wf-name">{t.graph.name}</span>
        </button>
      ))}
    </div>

    <div class="wf-stage card reveal">
      {templates.map((t, i) => (
        <div class="wf-panel" id={`wf-panel-${i}`} role="tabpanel" aria-labelledby={`wf-tab-${i}`} hidden={i !== 0}>
          <div class="wf-head">
            <div>
              <h3 class="wf-title">{t.title}</h3>
              <p class="wf-desc">{t.desc}</p>
            </div>
            <div class="wf-meta">
              <span class="tag">{t.category}</span>
              <span class="tag">{t.nodes.length} 节点 · {t.edges.length} 连线</span>
              {anyShot && t.shot && (
                <div class="wf-seg" role="group" aria-label="视图切换">
                  <button type="button" class="wf-seg-btn" aria-pressed="true" data-view="diagram">✨ 矢量流程图</button>
                  <button type="button" class="wf-seg-btn" aria-pressed="false" data-view="shot">🖥️ 真实软件截图</button>
                </div>
              )}
            </div>
          </div>

          <div class="wf-diagram" data-kind="diagram">
            <svg viewBox={t.viewBox} preserveAspectRatio="xMidYMid meet" role="img" aria-label={`${t.graph.name} 工作流示意图`}>
              <defs>
                <pattern id={`dots-${i}`} width="26" height="26" patternUnits="userSpaceOnUse">
                  <circle cx="1.5" cy="1.5" r="1.4" fill="rgba(255,255,255,.07)" />
                </pattern>
              </defs>
              <rect x="-10000" y="-10000" width="20000" height="20000" fill={`url(#dots-${i})`} />
              {t.edges.map((e) => (
                <g>
                  <path d={e.d} fill="none" stroke={e.color} stroke-opacity=".28" stroke-width="3.2" />
                  <path class="wire-flow" d={e.d} fill="none" stroke={e.color} stroke-width="3.2" stroke-dasharray="10 16" stroke-linecap="round" />
                </g>
              ))}
              {t.nodes.map((n) => {
                const c = colorOf(n.group);
                return (
                  <g class="node">
                    <rect x={n.x} y={n.y} width={n.w} height={n.h} rx="14" fill="#17181f" stroke="rgba(255,255,255,.13)" stroke-width="1.5" />
                    <path d={`M${n.x + 14},${n.y} H${n.x + n.w - 14}`} stroke={c} stroke-width="3.8" stroke-linecap="round" />
                    <text x={n.x + 16} y={n.y + 32} font-size="17.5" font-weight="650" fill="#ececef">{n.icon} {n.name}</text>
                    {n.inputs.map((p, pi) => {
                      const pc = portColor((p as { type?: string }).type, n.group);
                      return (
                        <g>
                          <circle cx={n.x} cy={t.portY(n, pi)} r="6.5" fill="#17181f" stroke={pc} stroke-width="3" />
                          <text x={n.x + 15} y={t.portY(n, pi) + 5} font-size="14.5" fill="#a1a3ad">{shortLabel(p.label)}</text>
                        </g>
                      );
                    })}
                    {n.outputs.map((p, pi) => {
                      const pc = portColor((p as { type?: string }).type, n.group);
                      return (
                        <g>
                          <circle cx={n.x + n.w} cy={t.portY(n, pi)} r="6.5" fill={pc} />
                          <text x={n.x + n.w - 15} y={t.portY(n, pi) + 5} font-size="14.5" fill="#a1a3ad" text-anchor="end">{shortLabel(p.label)}</text>
                        </g>
                      );
                    })}
                  </g>
                );
              })}
            </svg>
          </div>

          {t.shot && (
            <div class="wf-shot" data-kind="shot" hidden>
              <img
                src={url(t.shot)}
                alt={`软件内载入「${t.graph.name}」模板的真实截图`}
                data-caption={`${t.graph.name} — 真实画布运行截图（点击放大）`}
                data-zoomable
                loading="lazy"
                width="1440"
                height="900"
              />
            </div>
          )}

          <div class="wf-foot">
            <ol class="wf-steps" aria-label="流程步骤速览">
              {t.steps.map((st, si) => (
                <>
                  {si > 0 && <li class="wf-step-arr" aria-hidden="true">→</li>}
                  <li class="wf-step" style={`--sc:${st.color}`}>
                    <span>{st.icon}</span>
                    <span>{st.name}</span>
                  </li>
                </>
              ))}
            </ol>
            <div class="wf-legend" aria-label="端口颜色图例">
              {legendPorts.map((lp) => (
                <span><i style={`background:${lp.color}`}></i>{lp.label}</span>
              ))}
            </div>
          </div>
          <p class="wf-scroll-hint" aria-hidden="true">← 左右滑动流程图或直接查看下方步骤速览 →</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .wf-section { background: linear-gradient(180deg, transparent, rgba(124, 116, 255, .045) 35%, transparent); }
  .wf-tabs { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; margin-bottom: 22px; }
  .wf-tab {
    display: inline-flex; align-items: center; gap: 8px;
    height: 40px; padding: 0 16px 0 10px; border-radius: 999px;
    border: 1px solid var(--border-2); background: rgba(255, 255, 255, .03);
    color: var(--text-2); font-size: 14px;
    transition: all .2s var(--ease);
  }
  .wf-tab:hover { color: var(--text); border-color: var(--border-3); }
  .wf-tab[aria-selected="true"] {
    background: var(--accent-soft);
    border-color: var(--accent-ring);
    color: #fff;
    box-shadow: 0 4px 18px -6px rgba(124, 116, 255, .55);
  }
  .wf-emoji { width: 26px; height: 26px; display: grid; place-items: center; font-size: 15px; border-radius: 50%; background: rgba(255, 255, 255, .06); }

  .wf-stage { padding: 26px; }
  .wf-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 20px; flex-wrap: wrap; }
  .wf-title { font-size: 20px; font-weight: 650; }
  .wf-desc { margin-top: 6px; color: var(--text-2); font-size: 14.5px; max-width: 720px; }
  .wf-meta { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; }
  .wf-meta .tag { height: 30px; padding: 0 11px; font-size: 12.5px; }

  .wf-seg {
    display: inline-flex; padding: 3px; border-radius: 999px;
    background: rgba(255, 255, 255, .04); border: 1px solid var(--border-2);
  }
  .wf-seg-btn {
    height: 28px; padding: 0 12px; border-radius: 999px;
    font-size: 12.5px; font-weight: 500; color: var(--text-2);
    transition: all .2s var(--ease);
  }
  .wf-seg-btn:hover { color: var(--text); }
  .wf-seg-btn[aria-pressed="true"] {
    background: var(--accent); color: #fff;
    box-shadow: 0 4px 14px -4px rgba(124, 116, 255, .85);
  }

  .wf-diagram, .wf-shot {
    margin-top: 20px; border-radius: 13px; overflow: hidden;
    border: 1px solid var(--border-2); background: #0c0d12;
  }
  .wf-diagram { overflow-x: auto; scrollbar-width: thin; }
  .wf-diagram svg { width: 100%; min-width: 820px; height: auto; max-height: 460px; font-family: var(--font); }
  .wf-shot img { width: 100%; height: auto; }
  .wire-flow { animation: dash 1.3s linear infinite; }
  @keyframes dash { to { stroke-dashoffset: -26; } }

  .wf-foot {
    margin-top: 16px;
    display: flex; align-items: center; justify-content: space-between; gap: 14px; flex-wrap: wrap;
  }
  .wf-steps {
    list-style: none;
    display: flex; align-items: center; flex-wrap: wrap; gap: 6px;
  }
  .wf-step {
    display: inline-flex; align-items: center; gap: 5px;
    padding: 4px 10px; border-radius: 8px; font-size: 12.5px; color: var(--text-2);
    background: rgba(255, 255, 255, .035);
    border: 1px solid var(--border);
    border-left: 2.5px solid var(--sc);
  }
  .wf-step-arr { font-size: 12px; color: var(--text-3); }
  .wf-legend {
    display: flex; align-items: center; flex-wrap: wrap; gap: 10px;
    font-size: 12px; color: var(--text-3);
  }
  .wf-legend span { display: inline-flex; align-items: center; gap: 5px; }
  .wf-legend i { width: 8px; height: 8px; border-radius: 50%; display: inline-block; }

  .wf-scroll-hint { display: none; }
  @media (max-width: 760px) {
    .wf-scroll-hint { display: block; margin-top: 10px; text-align: center; font-size: 12px; color: var(--text-3); }
    .wf-tabs { flex-wrap: nowrap; justify-content: flex-start; overflow-x: auto; padding-bottom: 6px; scrollbar-width: none; margin-left: -18px; margin-right: -18px; padding-left: 18px; padding-right: 18px; }
    .wf-tab { flex: 0 0 auto; }
    .wf-stage { padding: 16px; }
    .wf-diagram svg { max-height: none; }
  }
</style>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>('.wf-tab');
  const panels = document.querySelectorAll<HTMLElement>('.wf-panel');
  tabs.forEach((tab) => tab.addEventListener('click', () => {
    const idx = tab.dataset.wf;
    tabs.forEach((t) => t.setAttribute('aria-selected', String(t === tab)));
    panels.forEach((p) => { p.hidden = p.id !== `wf-panel-${idx}`; });
  }));

  let view = 'diagram';
  const applyView = () => {
    document.querySelectorAll<HTMLButtonElement>('.wf-seg [data-view]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.view === view)));
    panels.forEach((p) => {
      const hasShot = !!p.querySelector('[data-kind="shot"]');
      p.querySelectorAll<HTMLElement>('[data-kind]').forEach((el) => {
        el.hidden = hasShot ? el.dataset.kind !== view : el.dataset.kind !== 'diagram';
      });
    });
  };
  document.querySelectorAll<HTMLButtonElement>('.wf-seg [data-view]').forEach((b) => b.addEventListener('click', () => {
    view = b.dataset.view || 'diagram';
    applyView();
  }));
</script>
